# =====================================================================
# parole-mutanti.conf — Blocco Caddy per "Parole Mutanti" (via import)
# =====================================================================
# GENERATO da deploy.sh --caddy e scritto in /etc/caddy/sites/parole-mutanti.conf.
# Il Caddyfile principale lo include con:  import /etc/caddy/sites/*.conf
#
# I valori di dominio, porta e certificato TLS vengono sostituiti da deploy.sh.
# Se non vengono forniti certificati, la riga tls resta vuota e Caddy usa
# Let's Encrypt automatico; altrimenti usa i certificati esistenti.
# =====================================================================

https://__DOMAIN__ {
    __TLS_LINE__

    # Compressione
    encode gzip zstd

    # Header di sicurezza
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss:; font-src 'self'"
        Strict-Transport-Security "max-age=31536000"
    }

    # Log dedicato (richiede che la cartella esista e i permessi siano corretti)
    log {
        output file /var/log/caddy/parole-mutanti.log {
            roll_size 10mb
            roll_keep 5
        }
    }

    # Reverse proxy al backend Node (WebSocket supportato)
    reverse_proxy 127.0.0.1:__PORT__ {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
}
