# =====================================================================
# .env.example — Template variabili d'ambiente "Parole Mutanti"
# =====================================================================
# Copia questo file in `.env` e inserisci i valori reali.
# MAI committare il file `.env` reale.

# --- Server ---
# Porta interna su cui ascolta il backend Node (dev WSL)
PORT=8090
# Host di ascolto (in produzione: 127.0.0.1 dietro reverse proxy)
HOST=127.0.0.1
# Ambiente: development | production
NODE_ENV=development

# --- Database PostgreSQL ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://parole_user:CAMBIAMI@localhost:5432/parole_mutanti

# --- AI: DeepSeek API ---
# Chiave API DeepSeek per fallback validazione parole
DEEPSEEK_API_KEY=sk-CAMBIAMI
# URL base DeepSeek (default già impostato nel codice)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# Modello da usare
DEEPSEEK_MODEL=deepseek-chat
# Max chiamate/min per partita (rate limit)
DEEPSEEK_RATE_LIMIT_PER_MIN=10

# --- Gioco ---
# Limite massimo giocatori per partita (2-8)
MAX_PLAYERS=8
# Limite minimo giocatori per partita
MIN_PLAYERS=2
# Partite di default per "vittoria gioco" (1-4)
DEFAULT_GAMES_TO_WIN=2
# Tempo di default per turno in secondi (5-60)
DEFAULT_TURN_SECONDS=30
# Lunghezza parola iniziale minima
INITIAL_WORD_MIN_LENGTH=5
# Lunghezza parola iniziale massima
INITIAL_WORD_MAX_LENGTH=8

# --- Sicurezza ---
# Segreto per generare ID sessione (rigenera con: openssl rand -hex 32)
SESSION_SECRET=CAMBIAMI-CON-OPENSSL-RAND

# --- Logging ---
# Livello log: error | warn | info | debug
LOG_LEVEL=info

# --- Path pubblico (per produzione dietro reverse proxy) ---
# Vuoto in dev (root), path in produzione se servito sotto sottopath
PUBLIC_BASE_PATH=
